# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dữ liệu lúc chạy: CSDL ván chơi (var/) và file từ điển nếu để trong repo
/var/
*.db
*.db-wal
*.db-shm

# Cloudflare / OpenNext
/.open-next/
/.wrangler/
.dev.vars
cloudflare-env.d.ts

# Playwright
/test-results/
/playwright-report/
/blob-report/

# Token/khóa truy cập: không bao giờ commit (thư mục này thường nằm ngoài repo, đây chỉ là lớp bảo vệ)
.credentials/
