{
  "name": "doanchu",
  "version": "1.3.10",
  "private": true,
  "scripts": {
    "dev": "node scripts/with-dev-vars.mjs next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && wrangler types worker/worker-types.d.ts --env-interface Env && tsc -p worker/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:prod": "E2E_BASE_URL=https://doanchu.pqv.workers.dev playwright test",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/seed-supabase.ts",
    "keywords": "tsx scripts/export-keywords.ts",
    "syllables": "tsx scripts/export-syllables.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.8",
    "@supabase/supabase-js": "^2.117.2",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "better-sqlite3": "^13.0.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "supabase": "^2.119.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=22"
  }
}
