{
  // Kiểm tra kiểu cho worker Cloudflare (Durable Object). Tách khỏi tsconfig gốc vì kiểu của workerd xung đột với DOM của Next.
  // worker-types.d.ts do `wrangler types` sinh ra (npm run typecheck tự chạy), không commit.
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true
  },
  "include": ["./**/*.ts", "../src/lib/versus/**/*.ts", "../src/lib/game/**/*.ts"]
}
